      },
      "assertions": [
        {
          "type": "output_equals",
          "path": "status",
          "value": "passed"
        },
        {
          "type": "output_equals",
          "path": "api_version",
          "value": "c2.build-hook/v1"
        },
        {
          "type": "cel_true",
          "expr": "outputs.artifact_refs.size() == 4 && outputs.artifact_refs[\"tests.log\"].name == \"tests.log\""
        },
        {
          "type": "cel_true",
          "expr": "calls.size() == 4 && calls.all(c, c.inputs.capture_diagnostics == \"always\")"
        },
        {
          "type": "cel_true",
          "expr": "calls.filter(c, c.node_path.endsWith(\"/test_integration/test_integration\"))[0].inputs.run.contains(\"-tags=integration\") && calls.filter(c, c.node_path.endsWith(\"/test_races/test_races\"))[0].inputs.run.contains(\"-race ./pkg/workflow ./pkg/jobdb/secrets/... ./pkg/jobdb/cli ./examples/secret-provider\")"
