              "outputs": {
                "success": true,
                "exit_code": 0,
                "timed_out": false,
                "error_message": "",
                "stdout": ""
              },
              "artifacts": {
                "environment.log": "native evidence\n"
              }
            }
          },
          {
            "match": {
              "node_path": "jobdb-verify-test/invoke/jobdb-build-verify/test_integration/test_integration"
            },
            "behavior": {
              "mode": "return",
              "outputs": {
                "success": true,
                "exit_code": 0,
                "timed_out": false,
                "error_message": "",
                "stdout": ""
              },
              "artifacts": {
                "tests.log": "native evidence\n"
              }
            }
          },
          {
            "match": {
              "node_path": "jobdb-verify-test/invoke/jobdb-build-verify/test_races/test_races"
            },
            "behavior": {
              "mode": "return",
              "outputs": {
                "success": true,
                "exit_code": 0,
                "timed_out": false,
                "error_message": "",
                "stdout": ""
              },
              "artifacts": {
                "races.log": "native evidence\n"
              }
            }
          },
          {
            "match": {
              "node_path": "jobdb-verify-test/invoke/jobdb-build-verify/summarize/summarize"
            },
            "behavior": {
              "mode": "return",
              "outputs": {
                "success": true,
                "exit_code": 0,
