+
+func TestReferenceOnlyExecutionTaskArtifacts(t *testing.T) {
+	for _, key := range []*jobdb.ArtifactKey{nil, {JobId: "job", Name: "stored", TaskOrdinal: 1, SizeBytes: -1}, {Name: "stored", SizeBytes: 0}} {
+		_, err := executionTaskIO(&jobdb.ExecutionSnapshot{Data: json.RawMessage(`null`), Artifacts: []jobdb.ExecutionArtifact{{Name: "logical", Key: key}}})
+		require.Error(t, err)
+	}
+	key := &jobdb.ArtifactKey{JobId: "job", TaskOrdinal: 1, Name: "stored", SizeBytes: 0}
+	out, err := executionTaskIO(&jobdb.ExecutionSnapshot{Data: json.RawMessage(`null`), Artifacts: []jobdb.ExecutionArtifact{{Name: "logical", Key: key}}})
+	require.NoError(t, err)
+	require.EqualValues(t, 0, out.Artifacts[0].SizeBytes)
+	require.Equal(t, "logical", out.Artifacts[0].Name)
+	require.Equal(t, key, out.Artifacts[0].Key)
+}
