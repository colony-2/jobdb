--- /dev/null
+++ b/pkg/pgjobdb/runtime/integration/configuration_test.go
@@ -0,0 +1,37 @@
+package integration_test
+
+import (
+	"context"
+	"database/sql"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/colony-2/jobdb/pkg/jobdb"
+	"github.com/colony-2/jobdb/pkg/jobdb/runtime/remote"
+	"github.com/colony-2/jobdb/pkg/jobdb/runtimetest"
+	pgruntime "github.com/colony-2/pgjobdb/pkg/pgjobdb/runtime"
+)
+
+func TestTenantConfiguration(t *testing.T) {
+	for _, transport := range []string{"embedded", "http"} {
+		t.Run(transport, func(t *testing.T) {
+			runDatabaseTest(t, func(ctx context.Context, db *sql.DB) {
+				backend, err := pgruntime.NewSQLDB(ctx, db, pgruntime.Config{BlobStoreURI: "blobfs://" + t.TempDir()})
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer backend.Close(ctx)
+				var runtime jobdb.WorkflowRuntime = backend
+				if transport == "http" {
+					server := httptest.NewServer(remote.NewServer(backend))
+					defer server.Close()
+					runtime, err = remote.New(server.URL, nil)
+					if err != nil {
+						t.Fatal(err)
+					}
+				}
+				runtimetest.RunConfigurationConformance(t, runtime)
+			})
+		})
+	}
+}
