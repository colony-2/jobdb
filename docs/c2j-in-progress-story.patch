+			r.OnTaskEnd(jobworkflow.TaskEndEvent{InvocationID: "work/attempt:1", TaskType: "work:work", AttemptNumber: 1, Output: jobdb.NewTaskDataOrPanic("old output", jobdb.NewArtifactFromBytes("old.txt", []byte("old"))), At: time.Now()})
